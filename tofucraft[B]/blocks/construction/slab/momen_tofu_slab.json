{
    "format_version": "1.26.50",
    "minecraft:block": {
        "description": {
            "identifier": "tofucraft:momen_tofu_slab",
            "menu_category": {
                "category": "construction",
                "group": "tofucraft:itemGroup.name.slab"
            },
            "states": {
                "tofucraft:double": {
                    "values": {
                        "min": 0,
                        "max": 1
                    }
                }
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:vertical_half"
                    ]
                }
            }
        },
        "components": {
            "minecraft:geometry": {
                "identifier": "geometry.tofucraft.slab",
                "bone_visibility": {
                    "bottom": "q.block_state('tofucraft:double') == 0 && q.block_state('minecraft:vertical_half') == 'bottom'",
                    "top": "q.block_state('tofucraft:double') == 0 && q.block_state('minecraft:vertical_half') == 'top'",
                    "double": "q.block_state('tofucraft:double') == 1"
                }
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "momen_tofu_block"
                }
            },
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    8,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    8,
                    16
                ]
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 1
            },
            "minecraft:map_color": "#C7C7C7",
            "minecraft:light_dampening": 0,
            "minecraft:loot": "loot_tables/blocks/construction/momen_tofu_slab.json",
            "minecraft:tags": [
                "minecraft:is_shovel_item_destructible",
                "tofucraft:slab"
            ],
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "liquid_type": "water",
                        "can_contain_liquid": true
                    }
                ]
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:vertical_half') == 'top'",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [
                            -8,
                            8,
                            -8
                        ],
                        "size": [
                            16,
                            8,
                            16
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -8,
                            8,
                            -8
                        ],
                        "size": [
                            16,
                            8,
                            16
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('tofucraft:double') == 1",
                "components": {
                    "minecraft:collision_box": true,
                    "minecraft:selection_box": true,
                    "minecraft:light_dampening": 15,
                    "minecraft:loot": "loot_tables/blocks/construction/momen_tofu_slab_double.json"
                }
            }
        ]
    }
}